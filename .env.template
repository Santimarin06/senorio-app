# Copia este archivo a .env y completa los valores. NO subas .env a git.
#
# Las variables EXPO_PUBLIC_* viajan dentro de la app instalada: no son secretos.
# Aquí solo va la clave pública (anon, o "publishable" en proyectos nuevos de Supabase),
# protegida con políticas RLS. NUNCA pongas la service_role / secret key en este archivo.
#
# Cómo obtener los valores: en https://supabase.com/dashboard abre el proyecto y ve a
# Project Settings > API (o "Connect" > App Frameworks). Copia la "Project URL" y la clave
# "anon public" (o "publishable"). Sin estos dos valores todas las pantallas con datos
# muestran un error de configuración (src/config/env.ts).

# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co (sin barra al final)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública anon / publishable (empieza por "eyJ" o por "sb_publishable_")
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# No hay más variables. El WhatsApp del local, sus coordenadas, horarios, multas y medios de
# pago no son configuración del entorno: viven en src/config/negocio.ts (D-03, D-04).
