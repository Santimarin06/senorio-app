{
  "expo": {
    "name": "Señorío Barber",
    "slug": "senorio-barber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono-app.png",
    "scheme": "senoriobarber",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.senoriobarber.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icono-adaptativo.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Señorío Barber usa tu ubicación solo mientras ves el mapa, para mostrarte dónde estás respecto a la barbería."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Señorío Barber usa la cámara solo para fotografiar el comprobante de tu anticipo.",
          "photosPermission": "Señorío Barber abre tus fotos solo para que elijas el comprobante de tu anticipo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notificacion-icono.png",
          "color": "#111111"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b7c63a85-14da-43e2-9ab0-cfadcd9fe304"
      }
    },
    "owner": "santimarin06"
  }
}
